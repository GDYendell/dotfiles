{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "gdy",
  "version": "0.0.1",
  "description": "Top bar for GlazeWM.",
  "tags": [
    "topbar"
  ],
  "previewImages": [],
  "repositoryUrl": "",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "includeFiles": [
        "*.html",
        "*.css",
        "*.js",
        "work-end.mp3",
        "break-end.wav"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "26px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "audio-panel",
      "htmlPath": "./audio.html",
      "includeFiles": [
        "*.html",
        "*.css",
        "*.js"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell",
            "argsRegex": "^-NoProfile -File C:\\\\Users\\\\GaryYendell\\\\\\.glzr\\\\zebar\\\\gdy\\\\set-audio-default\\.ps1 \\{[0-9a-fA-F.]+\\}\\.\\{[0-9a-fA-F-]+\\}$"
          },
          {
            "program": "explorer",
            "argsRegex": "^ms-settings:sound$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-8px",
          "offsetY": "30px",
          "width": "400px",
          "height": "400px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
