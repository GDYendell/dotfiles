#!/usr/bin/env bash
# Print context for today's Obsidian daily note, or render a JSON entry from stdin and append it.
# Never creates the note: it comes from an Obsidian template.
# Without DEVLOG_DIR (e.g. over SSH), entries are written to an outbox directory instead, and
# `devlog-note pull <host>` appends them to the matching daily notes here.
set -euo pipefail

outbox="${DEVLOG_OUTBOX:-$HOME/.devlog/outbox}"

# Daily note path for a date (default today).
note_for() { echo "$DEVLOG_DIR/$(LC_ALL=C date -d "${1:-today}" +%Y/%m-%b/%Y-%m-%d).md"; }

note=""
[[ -n ${DEVLOG_DIR:-} ]] && note="$(note_for)"
repo="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"

# JSON entry -> Obsidian markdown. Schema:
#   {topic, summary, lessons: [{q, a}], files: [path], turns: [{prompt, outcome}]}
render='
def quote($p): split("\n") | map(if . == "" then ($p | rtrimstr(" ")) else $p + . end) | join("\n");
def callout($head; $body): if $body == "" then empty else "\($head)\n\($body)" end;
# Escape < outside backtick spans, or Obsidian treats e.g. <slot> as raw HTML and stops rendering.
def esc: split("`") | to_entries | map(if .key % 2 == 0 then .value | gsub("<"; "\\<") else .value end) | join("`");

if (.summary | type) != "string" or .summary == "" then error("summary is required")
elif (.turns | type) != "array" or (.turns | length) == 0 then error("turns must be a non-empty array")
elif any(.turns[]; (.prompt | type) != "string" or (.outcome | type) != "string")
  then error("each turn needs a prompt and an outcome")
else
  (.lessons // []) as $lessons | (.files // []) as $files |
  [
    "## \($time) · \($repo) — \(.topic // "untitled" | esc)",
    (.summary | esc),
    callout("> [!tip] Lessons";
      $lessons | map("**\(.q | esc)**\n\(.a | esc)" | quote("> ")) | join("\n>\n")),
    callout("> [!abstract]- Files (\($files | length))";
      $files | map("> - `\(.)`") | join("\n")),
    callout("> [!example]- Conversation (\(.turns | length) prompt\(if (.turns | length) == 1 then "" else "s" end))";
      .turns | map((.prompt | esc | quote("> > ")) + "\n>\n> → " + (.outcome | esc | gsub("\n"; " "))) | join("\n>\n")),
    "---"
  ] | join("\n\n")
end
'

case "${1:-context}" in
  context)
    if [[ -z $note ]]; then echo "Today's note: OUTBOX: $outbox"
    elif [[ -f $note ]]; then echo "Today's note: $note"
    else echo "Today's note: MISSING: $note"
    fi
    echo "Repo: $repo"
    ;;
  append)
    entry="$(jq -r --arg time "$(date +%H:%M)" --arg repo "$repo" "$render")"
    if [[ -z $note ]]; then
      mkdir -p "$outbox"
      file="$outbox/$(date +%Y-%m-%d-%H%M%S)-$repo.md"
      printf '\n%s\n' "$entry" > "$file"
      echo "Written to outbox: $file"
    else
      [[ -f $note ]] || { echo "MISSING: $note" >&2; exit 1; }
      printf '\n%s\n' "$entry" >> "$note"
    fi
    ;;
  render)
    jq -r --arg time "$(date +%H:%M)" --arg repo "$repo" "$render"
    ;;
  pull)
    # Append each entry in <host>'s outbox to the daily note for its date, then delete it there.
    # Entries whose note doesn't exist yet are left on the host.
    host="${2:?usage: devlog-note pull <host> [remote-outbox]}"
    remote="${3:-.devlog/outbox}"
    [[ -n $note ]] || { echo "DEVLOG_DIR not set" >&2; exit 1; }

    # `; true` so an empty outbox succeeds but an ssh failure still stops the pull.
    files="$(ssh "$host" "ls $remote/*.md 2>/dev/null; true")"
    [[ -n $files ]] || { echo "Nothing in $host:$remote"; exit 0; }

    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    scp -q "$host:$remote/*.md" "$tmp/"

    done=()
    for f in "$tmp"/*.md; do
      name="$(basename "$f")"
      target="$(note_for "${name:0:10}")"
      if [[ -f $target ]]; then
        cat "$f" >> "$target"
        done+=("$name")
        echo "Appended $name"
      else
        echo "Skipped $name: MISSING: $target"
      fi
    done

    if (( ${#done[@]} )); then
      ssh "$host" "cd $remote && rm -f -- $(printf '%q ' "${done[@]}")"
    fi
    ;;
  *)
    echo "usage: devlog-note [context|append|render|pull <host>]" >&2
    exit 2
    ;;
esac
